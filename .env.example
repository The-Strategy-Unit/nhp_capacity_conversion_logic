# Copy this file to .env and replace every placeholder needed for your command.
# Never commit .env or real credentials.

# Azure Blob Storage account HTTPS endpoint and results container.
AZ_STORAGE_EP=https://<storage-account>.blob.core.windows.net
AZ_STORAGE_RESULTS=<blob-container-name>

# Azure Table Storage HTTPS endpoint and model-run catalogue table.
AZ_TABLE_ENDPOINT=https://<storage-account>.table.core.windows.net
TABLE_NAME=<table-name>

# Capacity catalogue and blob-path environment: dev or prod.
CAPACITY_MODEL_VERSION=dev

# Microsoft Forms iframe src URL used by the Shiny feedback dialog.
FEEDBACK_FORM_URL=https://forms.office.com/Pages/ResponsePage.aspx?id=<form-id>&embed=true

# Posit Connect server and API credentials used for deployment and access sync.
CONNECT_SERVER=https://<connect-server>
CONNECT_API_KEY=<posit-connect-api-key>

# Existing Connect content GUID. Required for redeployment and access sync;
# it may be empty when running the app locally or creating a new deployment.
CONNECT_APP_ID=00000000-0000-0000-0000-000000000000

# Case-insensitive, comma-separated substrings matched anywhere in scenario or
# run_stage. ACCESS_SYNC_MODE must be dry-run or apply.
ACCESS_SYNC_KEYWORDS=test,other
ACCESS_SYNC_MODE=dry-run

# POSIT_PRODUCT is set automatically by Posit Connect. Leave it unset locally.
